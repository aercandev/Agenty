{
  "name": "agenty",
  "productName": "Agenty",
  "version": "0.1.0",
  "description": "Birden fazla yapay zeka CLI'ını (Claude Code, Codex, Gemini, Ollama...) aynı anda çalıştıran masaüstü uygulaması",
  "main": "./out/main/index.js",
  "author": "Abdullah Ercan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "build": {
    "appId": "dev.agenty.app",
    "productName": "Agenty",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
